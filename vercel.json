{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/(auth|perfiles|swipes|matches|parches|chats|publicaciones|notificaciones|admin|reportes|bloqueos|config|api)(/.*)?",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
